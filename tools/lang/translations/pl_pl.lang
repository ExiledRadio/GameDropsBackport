# --- changes ---
config.gamedropsbackport.changes.tooltip=Zmiany z 26.x w poleceniach, mobach, blokach i przedmiotach, które 1.12.2 już ma.
config.gamedropsbackport.changes.enabled.tooltip=Wyłączone: wszystkie zmiany poniżej są wyłączone i wraca zachowanie z 1.12.2.
config.gamedropsbackport.changes.timeCommand.tooltip=/time działa na zegarach świata: set day, noon, night i midnight przesuwają do następnego; pause, resume i rate; of <clock>; query czasu i osi czasu; komunikaty z 26.1 (26.1).
config.gamedropsbackport.changes.gameRuleMessages.tooltip=/gamerule odpowiada komunikatami z 26.x, a ustawienie reguły na jej obecną wartość jest błędem (26.3).
config.gamedropsbackport.changes.teamColorNames.tooltip=Kolory drużyn przyjmują tylko swoje nazwy małymi literami z podkreślnikami, na przykład dark_purple (26.2).
config.gamedropsbackport.changes.bedBounce.tooltip=Łóżka odrzucają to, co na nie spada, w górę z 75%% prędkości zamiast 66%% (26.2).
config.gamedropsbackport.changes.mushroomStew.tooltip=Gulasz grzybowy robi się z miski i dowolnych dwóch grzybów (26.3).
config.gamedropsbackport.changes.shieldBeforeTools.tooltip=Z tarczą w drugiej ręce użycie motyki lub łopaty podnosi tarczę; skradaj się, aby orać lub robić ścieżki (26.3).
config.gamedropsbackport.changes.endermenRiding.tooltip=Endermany jadące na czymś otrzymują obrażenia od pocisków i nigdy się nie teleportują (26.3).
config.gamedropsbackport.changes.teleportTargets.tooltip=Endermani nigdy nie teleportują się na skałę macierzystą, tabliczki ani bloki z wodą ani w ogień, kaktusy, magmę i tym podobne; shulkery nigdy na skałę macierzystą (26.3).
config.gamedropsbackport.changes.persistentMobsIdle.tooltip=Trwałe moby (na przykład te z nazwą) przestają wędrować, gdy żaden gracz nie jest w promieniu 32 bloków (26.3).
config.gamedropsbackport.changes.leaderZombieHealth.tooltip=Zombie-przywódcy pojawiają się z pełnym, zwiększonym maksymalnym zdrowiem (26.1).
config.gamedropsbackport.changes.witchCloseThrows.tooltip=Wiedźmy rzucają mikstury wolniej w promieniu 2 bloków, więc z bliska już nie pudłują (26.1).
config.gamedropsbackport.changes.peacefulSpawnEggs.tooltip=Na poziomie Pokojowym dozowniki zachowują jaja przyzywające potworów zamiast je zużywać (26.2).
config.gamedropsbackport.changes.sunDamageEnchantments.tooltip=Niezniszczalność działa na hełm, który zombie lub szkielet nosi przeciw słońcu (26.3).
config.gamedropsbackport.changes.spectatorPortals.tooltip=Obserwatorzy przechodzą przez portale do Netheru, portale Endu i bramy Endu (26.3).
